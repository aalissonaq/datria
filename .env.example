# ==============================================================================
# Datria Foundation Environment Configuration Template
# Copy this file to .env and replace placeholder credentials with your local setup.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Runtime environment (development, test, production)
NODE_ENV=development

# API service port (default: 3000)
API_PORT=3000

# Web application origin allowed for CORS by the API (default: http://localhost:5173)
WEB_ORIGIN=http://localhost:5173

# Public API base URL consumed by the Vite web application
VITE_API_BASE_URL=http://localhost:3000/api/v1

# MySQL connection string for Prisma ORM
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: For local development with XAMPP MySQL, use user 'root' and password '' (empty) by default.
DATABASE_URL=mysql://root:@localhost:3306/datria_dev
