# ==============================================================================
# Datria Environment Configuration Template
# Feature: 002-identity-tenancy
# Copy this file to .env and replace placeholder credentials with your local setup.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Runtime environment (development, test, production)
NODE_ENV=development

# API service port (default: 3000)
API_PORT=3000

# Web application origin allowed for CORS by the API
WEB_ORIGIN=http://localhost:5173

# Public API base URL consumed by the Vite web application
VITE_API_BASE_URL=http://localhost:3000/api/v1

# MySQL connection string for Prisma ORM
DATABASE_URL=mysql://root:@localhost:3306/datria_dev
TEST_DATABASE_URL=mysql://root:@localhost:3306/datria_test

# JWT & Session secrets (at least 32 characters)
JWT_ACCESS_SECRET=datria_development_super_secret_access_key_at_least_32_bytes_long
JWT_ISSUER=datria-api
JWT_AUDIENCE=datria-web
ACCESS_TOKEN_TTL=15m
SESSION_IDLE_TTL=30m
SESSION_ABSOLUTE_TTL=8h

# Token Lifetimes
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=30m
INVITATION_TTL=7d

# Local Mailer (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@datria.local
MAILPIT_UI_URL=http://localhost:8025

# Security & Audit
AUDIT_RETENTION_DAYS=180
COOKIE_SECURE=false
